; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MATLAB UDP Viewer"
run/main_scene="res://addons/situs_core/core/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://addons/situs_core/networking/game_state.gd"
NetworkManager="*res://addons/situs_core/networking/network_manager.gd"
SceneManager="*res://addons/situs_core/core/scene_manager.gd"
DataChannel="*res://modul_data_channel/data_channel.gd"
SimulationRelay="*res://simulation_relay.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/situs_core/plugin.cfg")

[input]

debug_toggle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194306,"physical_keycode":4194306,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[situs_core]

default_scene="res://simulation_scene.tscn"
modules/modul_scene_loop=false
room/width_m=4.0
room/length_m=8.0
room/rotation_deg=-90.0

[xr]

openxr/enabled=true
openxr/startup_alert=false
shaders/enabled=true
